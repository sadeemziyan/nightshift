# Copy this file to ".env" in the same folder (notifier/) and fill in real values.
#   PowerShell:  Copy-Item .env.example .env
# ".env" is ignored by git, so keys never reach GitHub. Share real values in the group chat only.
# Never put real keys in THIS file: it is committed.

# From app.photon.codes -> your project -> Settings
SPECTRUM_PROJECT_ID=your-photon-project-id
SPECTRUM_PROJECT_SECRET=your-photon-secret-key

# Phone that receives dispatch texts, format +1XXXXXXXXXX (no spaces, no quotes).
# It must be added as a user in the Photon dashboard (Users page) first.
PHONE_DEFAULT=+15555550123

# Optional: a different phone per role. Any role left out uses PHONE_DEFAULT.
# PHONE_TRUCK_DRIVER=+15555550124
# PHONE_FIELD_OPERATOR=+15555550125
# PHONE_INSPECTOR=+15555550126

# With no keys or no phone, /approve still works but marks texts "simulated" (nothing is sent).
# Test one text:  python -m backend.api.notify truck_driver "Nightshift test"
